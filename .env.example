# Supabase — copy this file to `.env` and fill in your project values.
# Find both under Supabase Dashboard → Project Settings → API.
# The anon key is safe to expose in the browser; row-level security
# (supabase/schema.sql) is what protects the booking data.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
